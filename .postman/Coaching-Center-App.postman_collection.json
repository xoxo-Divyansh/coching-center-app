   "item": [
      {
         "name": "Auth",
         "item": [
            {
               "name": "Register",
               "request": {
                  "method": "POST",
                  "header": [
                     {
                        "key": "Content-Type",
                        "value": "application/json"
                     }
                  ],
                  "body": {
                     "mode": "raw",
                     "raw": "{\n  \"name\": \"xoxo\",\n  \"email\": \"xo@gmail.com\",\n  \"password\": \"123456\"\n}"
                  },
                  "url": {
                     "raw": "{{baseUrl}}/auth/register",
                     "host": [
                        "{{baseUrl}}"
                     ],
                     "path": [
                        "auth",
                        "register"
                     ]
                  }
               }
            },
            {
               "name": "Login",
               "event": [
                  {
                     "listen": "test",
                     "script": {
                        "exec": [
                           "const json = pm.response.json();",
                           "if (json.token) pm.collectionVariables.set('token', json.token);",
                           "if (json.user && json.user._id) pm.collectionVariables.set('userId', json.user._id);"
                        ],
                        "type": "text/javascript"
                     }
                  }
               ],
               "request": {
                  "method": "POST",
                  "header": [
                     {
                        "key": "Content-Type",
                        "value": "application/json"
                     }
                  ],
                  "body": {
                     "mode": "raw",
                     "raw": "{\n  \"email\": \"xo@gmail.com\",\n  \"password\": \"123456\"\n}"
                  },
                  "url": {
                     "raw": "{{baseUrl}}/auth/login",
                     "host": [
                        "{{baseUrl}}"
                     ],
                     "path": [
                        "auth",
                        "login"
                     ]
                  }
               }
            },
            {
               "name": "Get Me",
               "request": {
                  "method": "GET",
                  "header": [
                     {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                     }
                  ],
                  "url": {
                     "raw": "{{baseUrl}}/auth/me",
                     "host": [
                        "{{baseUrl}}"
                     ],
                     "path": [
                        "auth",
                        "me"
                     ]
                  }
               }
            },
            {
               "name": "Admin Test",
               "request": {
                  "method": "GET",
                  "header": [
                     {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
